# ============================================================
# 智能私厨环境变量配置模板
#
# 使用方法：
# 1. 将本文件复制为 .env
#    Windows PowerShell：Copy-Item .env.example .env
#    Linux/macOS：cp .env.example .env
# 2. 按下面说明填写 .env 中的真实配置
# 3. .env 只保存在本机，绝对不要提交到 GitHub
# ============================================================

# -------------------- 大模型配置（必填） --------------------
# 当前代码使用 OpenAI 兼容协议调用模型，因此可以接入：
# - 阿里云百炼/DashScope：qwen3.5-plus、qwen3-max、qwen-turbo 等
# - DeepSeek：deepseek-chat、deepseek-reasoner
# - OpenAI：gpt-4o-mini、gpt-4.1-mini 等
# - 其他提供 OpenAI 兼容接口的模型服务
#
# 注意：模型名称必须是你所选服务商实际提供的名称；如果更换模型，
# 还需要同步修改 app/agents/personal_chief.py 中的 MODEL_NAME。
MODEL_NAME=qwen3.5-plus
MODEL_PROVIDER=openai

# API 兼容接口地址。阿里云百炼示例：
# https://dashscope.aliyuncs.com/compatible-mode/v1
# 也可以填写你自己的兼容服务地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对应服务商的 API Key。不要填写引号，不要上传真实 Key。
DASHSCOPE_API_KEY=请填写你的大模型API_KEY

# -------------------- 联网搜索（建议填写） --------------------
# Tavily 用于搜索菜谱和食材信息；不填写时，联网搜索功能无法正常工作。
# 注册地址：https://tavily.com/
TAVILY_API_KEY=请填写你的TAVILY_API_KEY

# -------------------- LangSmith 链路追踪（可选） --------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-chief

# -------------------- 阿里云 OSS 图片上传（可选） --------------------
# 只有在使用“上传食材图片”功能时才需要配置。
OSS_ACCESS_KEY_ID=请填写你的阿里云AccessKey_ID
OSS_ACCESS_KEY_SECRET=请填写你的阿里云AccessKey_Secret
OSS_BUCKET=请填写你的OSS_BUCKET名称
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
